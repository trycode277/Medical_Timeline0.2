# Local development settings (uvicorn). Copy to .env; never commit .env.
# For Docker, use the .env.example at the repository root instead.

ENVIRONMENT=development            # "production" refuses to start with missing keys / default DB password

# --- Database (asyncpg driver required) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/timeline

# --- LLM (provider: anthropic | openai) ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5        # e.g. gpt-4o when LLM_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- CORS: JSON list of allowed browser origins ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Uploads / OCR ---
UPLOAD_DIR=/tmp/timeline_uploads
MAX_UPLOAD_MB=25
UPLOAD_SWEEP_MAX_AGE_MINUTES=60    # orphaned upload files older than this are deleted
OCR_LANGUAGE=eng
# Generate a unique random value of at least 32 bytes; required in production.
JWT_SECRET_KEY=medical-timeline-dev-secret-key-2026-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
