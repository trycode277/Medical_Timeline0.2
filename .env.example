# Copy to .env and fill in. Never commit .env. Secrets belong here (or your platform's
# secret manager), never in code or images.

# "production" (compose default) refuses to start with a missing LLM key, default DB
# credentials or CORS "*". Use "development" for local runs without keys.
ENVIRONMENT=development

# --- Database ---
# Use a URL-safe password (no @ : / ? #), e.g.:  openssl rand -hex 24
POSTGRES_USER=timeline
POSTGRES_PASSWORD=postgres
POSTGRES_DB=timeline
# Managed Postgres in the cloud? Set this instead (asyncpg driver required):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# --- LLM (provider: anthropic | openai) ---
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b       # e.g. gpt-4o when LLM_PROVIDER=openai
OLLAMA_BASE_URL=http://host.docker.internal:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Networking / CORS ---
# JSON list of allowed browser origins. Only needed if the UI is served from a different
# origin than the API; the bundled nginx proxy is same-origin. Keep the single quotes.
CORS_ORIGINS='["http://localhost:8080"]'
HTTP_PORT=8080
# Frontend build-time API base. "/api" = same origin through nginx.
VITE_API_URL=/api

# --- Uploads / OCR / workers ---
MAX_UPLOAD_MB=25                   # per file
NGINX_MAX_BODY=600m                # whole request (20 files x 25 MB, with headroom)
UPLOAD_TMPFS_SIZE=2g               # RAM-backed scratch space for uploads
UPLOAD_SWEEP_MAX_AGE_MINUTES=60    # orphaned uploads older than this are deleted
OCR_LANGS=eng                      # Tesseract packs installed in the image, e.g. eng,spa
OCR_LANGUAGE=eng                   # Tesseract language(s) used at runtime, e.g. eng+spa
WEB_CONCURRENCY=2                  # uvicorn workers
